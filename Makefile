# Build and run, in the two shapes this project is used in: a developer with
# two processes and hot reload, and an operator with one container.
#
# Everything here is a thin wrapper over a command you could type yourself.
# Nothing is hidden in it, because a build step whose contents you cannot see is
# a build step you cannot debug.

SHELL := /bin/bash
VENV  := backend/.venv
PY    := $(VENV)/bin/python
PIP   := $(VENV)/bin/pip
PORT  ?= 8000

.PHONY: help install dev-api dev-ui build build-ui build-image test lint \
        serve up down logs bootstrap status mock clean

help:
	@echo "Setup      make install          venv, backend deps, frontend deps"
	@echo "           make bootstrap        fetch GlotLID + FLORES controls (~1.6 GB)"
	@echo ""
	@echo "Develop    make dev-api          backend on :$(PORT), reloading"
	@echo "           make dev-ui           Vite on :5173, proxying /api"
	@echo "           make mock             scripted model endpoint on :9911"
	@echo "           make test             backend tests"
	@echo "           make lint             typecheck the frontend"
	@echo ""
	@echo "Build      make build            production UI into backend/static"
	@echo "           make build-image      the Docker image"
	@echo "           make lock             regenerate package-lock.json (pinned npm)"
	@echo ""
	@echo "Run        make serve            one process, built UI + API"
	@echo "           make up / down / logs docker compose"
	@echo "           make status           what is measured, and what is stale"

# -- setup --------------------------------------------------------------------

# `npm ci`, never `npm install`.
#
# `npm install` rewrites package-lock.json with whatever npm the developer
# happens to have, and npm versions disagree about which entries of the
# wasm32-wasi optional tree belong in a lockfile. A lockfile rewritten that way
# then fails `npm ci` inside the image -- so running setup on a fresh clone
# would quietly break the Docker build, and the failure arrives as
# "Missing: @emnapi/... from lock file", which reads like a corrupt lockfile.
#
# The lockfile is generated by the pinned toolchain instead: `make lock`.
# `[lid]` is not optional for anything that serves the page. `make serve` runs
# the real app on the host, and without fasttext its gate checks the writing
# system and not the language -- silently, which is the one way this project
# refuses to be wrong. The extra exists for the case where you only want to
# read stored results.
install: $(VENV)
	$(PIP) install -q -e "./backend[dev,lid]"
	cd frontend && npm ci
	@echo "Installed. 'make bootstrap' fetches the language-ID model and the"
	@echo "back-translator controls; without them the gate checks script but"
	@echo "not language, and nearly every result is 'unverified'."

$(VENV):
	python3 -m venv $(VENV)

bootstrap: ; $(VENV)/bin/polyglot bootstrap

# -- develop ------------------------------------------------------------------

dev-api: ; $(VENV)/bin/polyglot serve --port $(PORT) --reload
dev-ui:  ; cd frontend && npm run dev
mock:    ; $(PY) backend/tools/mock_models.py
test:    ; $(PY) -m pytest backend/tests -q
lint:    ; cd frontend && npx tsc -b --noEmit

# -- build --------------------------------------------------------------------

# The UI is typechecked and then bundled into backend/static, which FastAPI
# serves — so production is one process and there is no CORS story to get wrong.
build build-ui:
	cd frontend && npm run build
	@echo ""
	@echo "UI built into backend/static. 'make serve' runs it with the API."

build-image:
	docker build -t llm-polyglot-exam:latest .

# Regenerate package-lock.json with the npm the image has, not the one this
# machine has. Run it after changing a dependency, and commit the result.
lock:
	docker run --rm -v "$(CURDIR)/frontend":/w -w /w node:24-slim \
		npm install --package-lock-only --no-audit --no-fund
	@echo "Lockfile regenerated by the pinned toolchain. Commit it."

# -- run ----------------------------------------------------------------------

serve: ; $(VENV)/bin/polyglot serve --port $(PORT)
up:    ; docker compose up -d --build
down:  ; docker compose down
logs:  ; docker compose logs -f
status:; $(VENV)/bin/polyglot status

# Removes only what is regenerable. The database and the corpus are never
# touched here: the corpus is the one asset that cannot be rebuilt without
# paying for every generation again.
clean:
	rm -rf backend/static frontend/dist backend/.pytest_cache
	find backend -name __pycache__ -type d -prune -exec rm -rf {} +
	@echo "Removed build output. data/ is untouched — the corpus is not regenerable."
