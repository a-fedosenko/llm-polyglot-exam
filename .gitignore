# Secrets and anything naming an endpoint or a key.
.env
data/models.json

# Produced, regenerable. The corpus is the one thing here worth keeping, and it
# is kept on disk rather than in git: it grows by megabytes per scan.
data/polyglot.db
data/polyglot.db-*
data/corpus/
data/cache/
data/runs/
data/results/

# Fetched at bootstrap. GlotLID is 1.6 GB; the FLORES-derived controls are
# CC BY-SA 4.0 and share-alike attaches to derived text, so they are built
# locally and never redistributed.
data/models/
data/controls/flores.json

# Your own locale list, if you bring one.
schemes/*.json
!schemes/default.json
!schemes/catmint.json
languages/

# Build output and environments.
backend/static/
backend/.venv/
backend/*.egg-info/
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.pytest_cache/
