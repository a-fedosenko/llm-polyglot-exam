# Copy to .env. Nothing here is ever written to a result, stored in the
# database, or returned by an endpoint.

# ---------------------------------------------------------------------------
# Models. Two routes; the JSON file wins where both are set.
# ---------------------------------------------------------------------------

# The general route, and the only one most people need: a JSON file listing
# models one by one, each with its own endpoint and its own key. That is what
# lets one run reach OpenAI, a hosted gateway and a local vLLM at once.
# Copy .models.json.example to data/models.json and point this at it.
CUSTOM_MODEL_LIST_PATH=data/models.json

# Or: one gateway serving every model id, with one key.
# AGGREGATOR_BASE_URL=https://your-gateway/v1
# AGGREGATOR_ADMIN_API_KEY=sk-...

# Where to ask a gateway what models it serves, if it does not answer the
# standard `GET $AGGREGATOR_BASE_URL/models`. Discovery only — which models a
# run uses is never set here.
# AGGREGATOR_MODEL_LIST_URL=https://your-gateway/admin/models

# ---------------------------------------------------------------------------
# The judge and the reader panel are deliberately NOT configured here.
#
# They used to be, and it was wrong. A verdict is only comparable to another
# graded by the same judge and read back by the same reader — the tool stores
# both on every row and refuses to compare across them — which makes them the
# most identity-defining part of a measurement there is. Set once in a file and
# never seen again is how a run comes to be graded by something nobody
# remembers choosing.
#
# They are picked per run instead, from the models this configuration can
# actually reach, and they are shown on the page while the run is set up. The
# page proposes a starting pair and says what rule produced it; nothing is
# defaulted silently.
# ---------------------------------------------------------------------------

# The language everything is back-translated into, so the judge never has to
# read the target language. Installation-level because it is a property of who
# is operating the tool rather than of a measurement; a language that *is* the
# pivot is measured through a fallback automatically.
PIVOT=en

# ---------------------------------------------------------------------------
# The locale list a run is resolved against.
#
# `catmint` is a 602-tag TMS list whose dialects are named explicitly and whose
# script subtag appears last and only where it discriminates (sr-me-cyrl, but
# en-gb). That shape is what makes dialect work possible: `pt` is the umbrella
# and `pt-br` a variety beside it, so there is a neutral arm to contrast
# against. `default` is the 9,589-tag public catalogue.
# ---------------------------------------------------------------------------

SCHEME=catmint

# ---------------------------------------------------------------------------
# Serving. There is no authentication, because there is no second user and the
# port binding is the only control. Widening API_BIND puts an unguarded tool
# that spends your API budget on your network.
# ---------------------------------------------------------------------------

API_BIND=127.0.0.1
API_PORT=8000

# Hard ceiling on what one run may spend, whatever the page asks for. A
# capability test costs 9-15 calls and a three-model dialect battery 20-30;
# this exists to bound a loop that has gone wrong, not to stop the tool working.
MAX_CALLS_PER_RUN=200

# ---------------------------------------------------------------------------
# Docker only. The container writes the database and the raw corpus into the
# bind mount, so it runs as you rather than as root — otherwise your own CLI
# cannot read back what it wrote. Set these if your ids are not 1000.
# ---------------------------------------------------------------------------

# UID=1000
# GID=1000
